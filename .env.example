# The scripts read these values from the process environment.
# Uncomment only the paths you need to override.

# VGGT_PRETRAIN_PATH=/path/to/model.pt
# VGGT_FINAL_CHECKPOINT=/path/to/6L_best_AUC0641.pt
# VGGT_VISER_IMAGE_DIR=/path/to/input/images
# VGGT_WEIGHTS_DIR=/path/to/weights

# VGGT_DATA_ROOT=/path/to/datasets
# VGGT_CO3D_DIR=/path/to/co3d
# VGGT_CO3D_ANNOTATION_DIR=/path/to/co3d_annotations
# VGGT_DL3DV_DIR=/path/to/DL3DV-10K
# VGGT_BLENDED_MVS_DIR=/path/to/BlendedMVS_plusplus
# VGGT_MEGADEPTH_DIR=/path/to/megadepth
# VGGT_SCANNET_DIR=/path/to/scannet/extracted

# VGGT_OUTPUT_ROOT=/path/to/outputs
# VGGT_CHECKPOINT_ROOT=/path/to/checkpoints
# VGGT_LOG_ROOT=/path/to/logs
# VGGT_STAGE1_CHECKPOINT_DIR=/path/to/stage1/checkpoints
# VGGT_STAGE2_CHECKPOINT_DIR=/path/to/stage2/checkpoints
# VGGT_STAGE3_CHECKPOINT_DIR=/path/to/stage3/checkpoints
# VGGT_STAGE1_LOG_DIR=/path/to/stage1/logs
# VGGT_STAGE2_LOG_DIR=/path/to/stage2/logs
# VGGT_STAGE1_RESUME_CHECKPOINT=/path/to/stage1/checkpoint.pt
# VGGT_TASK_ONLY_CHECKPOINT_DIR=/path/to/task-only/checkpoints
# VGGT_PATCH_CHECKPOINT_DIR=/path/to/patch-focus/checkpoints
# VGGT_STAGE3_WARM_START=/path/to/stage2/checkpoint.pt
# VGGT_PATCH_WARM_START=/path/to/stage3/step1250.pt

# Used only by vggt-fresh/vggt-main/demo_viser.py.
# VGGT_HALO_CHECKPOINT=/path/to/stage1_final_step4000.pt
